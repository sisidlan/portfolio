# Production contact delivery (see docs/contact-setup.md).
# These two values are intentionally public and are included at build time.
PUBLIC_CONTACT_FORM_ENDPOINT=/api/contact/
PUBLIC_TURNSTILE_SITE_ID=

# Vercel function runtime only. Set credentials to Secret in Vercel.
# Never add PUBLIC_ to either private credential.
TURNSTILE_SECRET=
RESEND_API_TOKEN=

# Server-only configuration. Config is sufficient in Vercel.
CONTACT_FROM_EMAIL="Kevin de Graaf <contact@contact.kevindegraaf.com>"
CONTACT_TO_EMAIL=kdegraaf97@icloud.com
