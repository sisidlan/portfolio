{
    "name": "portfolio-kdegraaf",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "check": "astro check",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "pretest": "npm run build",
