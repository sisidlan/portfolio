---
// ============================================================================
// Project collection and optional view controls
// ============================================================================
import WorkEntry from './WorkEntry.astro';
import type { WorkProject, WorkView } from '../types/work';

interface Props {
    works: WorkProject[];
    id: string;
    heading?: string;
    enableViewToggle?: boolean;
    defaultView?: WorkView;
    viewStorageKey?: string;
}

const {
    works,
    id,
    heading,
    enableViewToggle = false,
    defaultView = 'list',
    viewStorageKey,
} = Astro.props;
---

<work-view-switcher
    class="work-browser"
    data-default-view={defaultView}
    data-storage-key={viewStorageKey}
>
    {(heading || enableViewToggle) && (
        <header class="work-browser__header">
            {heading && <h1>{heading}</h1>}
            {enableViewToggle && (
                <div class="work-view-toggle" role="group" aria-label="Choose project view">
                    <button
                        class="work-view-toggle__button"
                        type="button"
                        aria-label="List view"
                        aria-controls={id}
                        aria-pressed={defaultView === 'list' ? 'true' : 'false'}
                        data-work-view-option="list"
                    >
                        <span class="work-view-toggle__icon" aria-hidden="true">
                            <svg viewBox="0 0 38 28" focusable="false">
                                <path
                                    d="M11.2308 2.92308L35.2308 2.92452M11.2308 14L35.2308 14.0015M11.2308 25.0769L35.2308 25.0782M2 3.84615H3.84615V2H2V3.84615ZM2 14.9231H3.84615V13.0769H2V14.9231ZM2 26H3.84615V24.1538H2V26Z"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="4"
                                />
                            </svg>
                        </span>
                        <span class="work-view-toggle__label">List</span>
                    </button>
                    <button
                        class="work-view-toggle__button"
                        type="button"
                        aria-label="Grid view"
                        aria-controls={id}
                        aria-pressed={defaultView === 'grid' ? 'true' : 'false'}
                        data-work-view-option="grid"
                    >
                        <span class="work-view-toggle__icon" aria-hidden="true">
                            <svg viewBox="0 0 36 36" focusable="false">
                                <path
                                    d="M5.14258 22.5713H10.2861C12.0214 22.5715 13.4285 23.9786 13.4287 25.7139V30.8574C13.4286 32.5927 12.0214 33.9998 10.2861 34H5.14258C3.40723 33.9998 2.00015 32.5928 2 30.8574V25.7139L2.00391 25.5527C2.088 23.8923 3.46131 22.5714 5.14258 22.5713ZM25.7139 22.5713H30.8574C32.5927 22.5714 33.9998 23.9786 34 25.7139V30.8574C33.9998 32.5928 32.5928 33.9998 30.8574 34H25.7139C23.9786 33.9998 22.5714 32.5927 22.5713 30.8574V25.7139C22.5715 23.9786 23.9786 22.5715 25.7139 22.5713ZM5.14258 2H10.2861C12.0214 2.00023 13.4286 3.40727 13.4287 5.14258V10.2861C13.4285 12.0214 12.0214 13.4285 10.2861 13.4287H5.14258C3.40727 13.4286 2.00023 12.0214 2 10.2861V5.14258L2.00391 4.98145C2.08523 3.37432 3.37432 2.08523 4.98145 2.00391L5.14258 2ZM25.7139 2H30.8574C32.5928 2.00015 33.9998 3.40723 34 5.14258V10.2861C33.9998 12.0214 32.5927 13.4286 30.8574 13.4287H25.7139C23.9786 13.4285 22.5715 12.0214 22.5713 10.2861V5.14258C22.5714 3.46131 23.8923 2.088 25.5527 2.00391L25.7139 2Z"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="4"
                                />
                            </svg>
                        </span>
                        <span class="work-view-toggle__label">Grid</span>
                    </button>
                </div>
            )}
        </header>
    )}

    <div class="work-browser__content">
        <ol
            id={id}
            class="work-collection"
            data-work-collection
            data-work-view={defaultView}
            role="list"
        >
            {works.map((work) => (
                <WorkEntry work={work} titleIdPrefix={`${id}-title`} />
            ))}
        </ol>
    </div>
</work-view-switcher>

<style>
    /* ======================================================================
       Collection layouts
       ====================================================================== */
    .work-browser {
        display: block;
        width: 100%;
    }

    .work-browser__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: var(--work-header-height);
        margin-bottom: var(--work-header-bottom-gap);
    }

    .work-browser__header h1 {
        margin-bottom: 0;
    }

    .work-collection {
        width: 100%;
        margin: 0;
        padding: 0 0 var(--work-collection-bottom-gap);
        list-style: none;
    }

    .work-collection[data-work-view='list'] {
        display: flex;
        flex-direction: column;
        gap: var(--work-list-gap);
    }

    .work-collection[data-work-view='grid'] {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: var(--work-grid-column-gap);
        row-gap: var(--work-grid-row-gap);
    }

    .work-collection > :global(.work-collection__item:nth-child(odd)) {
        --work-thumbnail-rotation: var(--work-thumbnail-rotation-angle);
    }

    .work-collection > :global(.work-collection__item:nth-child(even)) {
        --work-thumbnail-rotation: calc(-1 * var(--work-thumbnail-rotation-angle));
    }

    @media (min-width: 48.0625rem) {
        .work-collection[data-work-view='grid']
            > :global(.work-collection__item:nth-child(4n + 3)) {
            --work-thumbnail-rotation: calc(-1 * var(--work-thumbnail-rotation-angle));
        }

        .work-collection[data-work-view='grid']
            > :global(.work-collection__item:nth-child(4n + 4)) {
            --work-thumbnail-rotation: var(--work-thumbnail-rotation-angle);
        }
    }

    /* ======================================================================
       View toggle
       ====================================================================== */
    .work-view-toggle {
        display: none;
        align-items: center;
        align-self: flex-start;
        justify-content: flex-end;
        gap: var(--work-view-toggle-button-gap);
        height: var(--work-view-toggle-height);
        margin-bottom: 0;
        padding-top: var(--work-view-toggle-padding-top);
    }

    .work-browser:defined .work-view-toggle {
        display: flex;
    }

    .work-view-toggle__button {
        display: inline-flex;
        align-items: center;
        gap: var(--work-view-toggle-content-gap);
        height: 100%;
        padding: 0 var(--work-view-toggle-padding-right) 0 var(--work-view-toggle-padding-left);
        border: var(--work-view-toggle-active-border-width) solid transparent;
        border-radius: var(--work-view-toggle-radius);
        background: transparent;
        color: var(--light-gray-ink-color);
        font-family: var(--font-display);
        font-size: var(--heading-4-size);
        font-weight: 400;
        line-height: 100%;
        letter-spacing: var(--heading-3-letter-spacing);
        text-transform: uppercase;
        cursor: pointer;
    }

    .work-view-toggle__icon {
        display: grid;
        flex: 0 0 var(--work-view-toggle-icon-box-size);
        width: var(--work-view-toggle-icon-box-size);
        height: var(--work-view-toggle-icon-box-size);
        place-items: center;
    }

    .work-view-toggle__icon svg {
        display: block;
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 100%;
    }

    .work-view-toggle__button:first-child .work-view-toggle__icon svg {
        width: var(--work-view-toggle-list-icon-width);
        height: var(--work-view-toggle-list-icon-height);
    }

    .work-view-toggle__button:last-child .work-view-toggle__icon svg {
        width: var(--work-view-toggle-grid-icon-size);
        height: var(--work-view-toggle-grid-icon-size);
    }

    .work-view-toggle__button:hover {
        color: var(--gray-ink-color);
    }

    .work-view-toggle__button[aria-pressed='true'] {
        color: var(--black-ink-color);
    }

    @supports selector(:focus-visible) {
        .work-view-toggle__button:focus-visible {
            color: var(--black-ink-color);
        }
    }

    .work-view-toggle__button[aria-pressed='true'] {
        border-color: var(--gray-ink-color);
    }

    .work-view-toggle__button[aria-pressed='true']:hover {
        border-color: var(--black-ink-color);
    }

    @supports selector(:focus-visible) {
        .work-view-toggle__button[aria-pressed='true']:focus-visible {
            border-color: var(--black-ink-color);
        }
    }

    @media (max-width: 64rem) {
        .work-collection[data-work-view='list'] {
            gap: var(--work-list-mobile-gap);
        }
    }

    @media (max-width: 48rem) {
        .work-collection[data-work-view='grid'] {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    import '../scripts/work-grid-alignment';
    import '../scripts/work-entry-hover';
    import '../scripts/work-view-toggle';
</script>
